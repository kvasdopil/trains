{
  "name": "rails-dispatcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "assess": "ASSESS=1 vitest run gameplay-assessment",
    "lint": "tsc --noEmit -p tsconfig.json && eslint .",
    "lint:format": "prettier . --check",
    "lint:full": "yarn lint && yarn lint:format && yarn test",
    "format": "prettier . --write",
    "deploy:preview": "vercel",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
